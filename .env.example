# Copy this file to .env and fill in your values. Never commit .env.
PORT=3000

# Where contact form messages are saved (one JSON object per line).
MESSAGES_FILE=data/messages.jsonl

# Optional: also email each message to you using Resend (https://resend.com).
# Leave these blank to only save messages to the file above.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Profile Site <onboarding@resend.dev>
